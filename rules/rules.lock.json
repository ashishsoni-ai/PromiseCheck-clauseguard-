          ],
          "source_span": "Orders placed through a marketplace partner or a third-party storefront"
        }
      ],
      "exceptions": [],
      "precedence": 100,
      "extraction_confidence": 1.0,
      "needs_human_review": false
    },
    {
      "rule_id": "partial-refund-opened-electronics-restocking-fee",
      "clause_ids": [
        "acme-refunds:006:0dbae093",
        "acme-refunds:015:8e0d8118"
      ],
      "entitlement": "partial_refund",
      "polarity": "grants",
      "conditions": [
        {
          "attribute": "item_category",
          "op": "in",
          "value": [
            "electronics"
          ],
          "source_span": "Opened electronics that are otherwise eligible"
        },
        {
          "attribute": "item_opened",
          "op": "==",
          "value": "yes",
          "source_span": "Opened electronics that are otherwise eligible are subject to a restocking fee of 15% of the item price"
        },
        {
          "attribute": "days_since_delivery",
          "op": "<=",
          "value": 30,
          "source_span": "Returns must be initiated within 30 days of delivery."
        }
      ],
      "exceptions": [],
      "precedence": 10,
      "extraction_confidence": 1.0,
      "needs_human_review": false
    },
    {
      "rule_id": "replacement-size-exchange",
      "clause_ids": [
        "acme-refunds:006:0dbae093",
        "acme-refunds:019:1d2921e7"
      ],
      "entitlement": "replacement",
      "polarity": "grants",
      "conditions": [
        {
          "attribute": "exchange_requests_used_this_order",
          "op": "<",
          "value": 1,
          "source_span": "may be requested once per order"
        },
        {
          "attribute": "replacement_stock_available",
          "op": "==",
          "value": "yes",
          "source_span": "is subject to stock availability"
        },
        {
          "attribute": "days_since_delivery",
          "op": "<=",
          "value": 30,
          "source_span": "Returns must be initiated within 30 days of delivery."
        }
      ],
      "exceptions": [],
      "precedence": 10,
      "extraction_confidence": 1.0,
      "needs_human_review": false
