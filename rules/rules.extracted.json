      "rule_id": "acme-refunds:006:0dbae093",
      "clause_ids": [
        "acme-refunds:006:0dbae093"
      ],
      "entitlement": "refund",
      "polarity": "denies",
      "conditions": [
        {
          "attribute": "days_since_delivery",
          "op": ">",
          "value": 30,
          "source_span": "Returns must be initiated within 30 days of delivery."
        }
      ],
      "exceptions": [],
      "precedence": 10,
      "extraction_confidence": 0.95,
      "needs_human_review": false
    },
    {
      "rule_id": "acme-refunds:007:b15ef9db",
      "clause_ids": [
        "acme-refunds:007:b15ef9db"
      ],
      "entitlement": "refund",
      "polarity": "denies",
      "conditions": [
        {
          "attribute": "item_category",
          "op": "in",
          "value": [
            "Innerwear and sleepwear",
            "Swimwear and swim accessories"
          ],
          "source_span": "Clearance items must be returned within 7 days of delivery. This shorter window applies even where the same item also falls under a category given a longer window elsewhere in this policy, and it is not extended by any promotion."
