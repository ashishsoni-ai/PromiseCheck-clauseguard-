# Secrets
.env

# Commit messages are always passed via `git commit -F .commit-msg`, never -m:
# PowerShell 5.1 mangles embedded double quotes, which silently corrupts any
# message containing a quoted clause or model ID.
# Globbed, not listed: `.commit-msg-l3` was committed as a tracked file in
# b5048c2 because only the two exact names were ignored. Any suffix now matches.
.commit-msg*

# Virtualenvs
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
coverage.xml
htmlcov/
report.xml

# DESIGN.md 7.1: "we ship the fetcher, not the corpus."
# Fetched policy text is cached locally and never committed.
policies/.cache/

# Model artifacts pulled at AUT build/run time
aut-naive/.index/
aut-strong/.index/
*.faiss

# OS
Thumbs.db
.DS_Store
